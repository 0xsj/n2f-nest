{
  "name": "n2f-nest",
  "version": "0.0.1",
  "description": "NestJS integration example for N2F modular monolith boundaries",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "bun run check:architecture && oxlint src/ test/",
    "check:architecture": "bun run scripts/check-error-boundaries.ts",
    "check": "bun run build && bun run lint && bun run test",
    "test": "vitest run",
    "test:organization": "N2F_RUN_ORGANIZATION_INTEGRATION=1 bun run test test/organization.integration.spec.ts",
    "test:chaos": "N2F_RUN_CHAOS_INTEGRATION=1 bun run test test/chaos.integration.spec.ts",
    "test:postgres": "N2F_RUN_POSTGRES_INTEGRATION=1 N2F_IDENTITY_STORAGE=postgres N2F_EVENT_TRANSPORT=local vitest run test/postgres.integration.spec.ts",
    "test:nats": "N2F_RUN_POSTGRES_INTEGRATION=1 N2F_RUN_NATS_INTEGRATION=1 N2F_IDENTITY_STORAGE=postgres N2F_EVENT_TRANSPORT=nats vitest run --no-file-parallelism test/postgres.integration.spec.ts src/shared/events/nats/broker.integration.spec.ts",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism"
  },
  "dependencies": {
    "@nats-io/transport-node": "3.4.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ts-pattern": "^5.9.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "8.15.5",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2"
  }
}
